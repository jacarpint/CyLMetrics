# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.pytest_cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# informes generados por los scripts de calidad
/reports/data-analysis.json
/reports/data-analysis.checkpoint.jsonl
# el historial SÍ se tracked (permite ver evolución)
!/reports/history/

# artefactos de desarrollo — no se versionan
/reports/*.log
/reports/*.pid
/reports/*.png
/reports/*.checkpoint.jsonl
/reports/checkpoint-*.jsonl
/reports/smoke*.json
/reports/quality-report.json
/reports/quality-report-live.json

# caché de Python
src/analysis/__pycache__/
src/analysis/**/__pycache__/

# typescript
*.tsbuildinfo
next-env.d.ts
