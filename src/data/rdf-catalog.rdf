<dcat:Dataset rdf:about="https://datosabiertos.jcyl.es/web/jcyl/set/es/medio-ambiente/informacion-auxiliar-lineas/1284687192746" dct:identifier="https://datosabiertos.jcyl.es/web/jcyl/set/es/medio-ambiente/informacion-auxiliar-lineas/1284687192746" >
<dct:title xml:lang="es">Cartografía Topográfica Urbana 1:1.000: Información auxiliar - lineas</dct:title>
<dct:description xml:lang="es">Capa de información auxiliar de la Cartografía Topográfica Urbana 1:1.000 con geometría de lineas.Mapa de entidades lineales que recopila, de las hojas de mapa de la serie Cartografía Topográfica Urbana 1:1.000, información complementaria al conjunto de temas del modelo de datos. Se incluyen aquí elementos auxiliares de la cartografía que, por sus características concretas, sirven para dar continuidad a los distintos objetos geográficos mediante el empleo de lineas virtuales de cierre.</dct:description>
<dcat:theme rdf:resource="http://datos.gob.es/kos/sector-publico/sector/medio-ambiente"/>
