<dct:title xml:lang="es">Calidad de las Aguas de Recreo</dct:title>
<dct:description xml:lang="es">Información sobre las aguas de recreo de Castilla y León: censos, número de expedientes sancionadores, visitas, actas, controles y toma de muestras desagregados por provincia.</dct:description>
<dcat:theme rdf:resource="http://datos.gob.es/kos/sector-publico/sector/salud"/>
