<dcat:Dataset rdf:about="https://datosabiertos.jcyl.es/web/jcyl/set/es/industria/instalad_mantened/1284208617621" dct:identifier="https://datosabiertos.jcyl.es/web/jcyl/set/es/industria/instalad_mantened/1284208617621" >
<dct:title xml:lang="es">Empresas Instaladoras y Mantenedoras de Castilla y León</dct:title>
<dct:description xml:lang="es">Relación de empresas habilitadas por los distintos reglamentos y categorías para realizar la actividad de empresas instaladoras y mantenedoras en Castilla y León dentro del ámbito reglamentario de la seguridad industrial. Para el ejercicio de su actividad se debe estar habilitado. por lo que se debe presentar ante la Administración una declaración responsable de cumplimiento de los medios humanos y materiales que se exigen en los diferentes reglamentos de seguridad industrial (Instalaciones de Baja Tensión, Ascensores, Instalaciones Térmicas en Edificios, Instalaciones Petrolíferas, etc.)</dct:description>
<dcat:theme rdf:resource="http://datos.gob.es/kos/sector-publico/sector/industria"/>
