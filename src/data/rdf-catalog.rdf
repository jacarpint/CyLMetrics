<dcat:Dataset rdf:about="https://datosabiertos.jcyl.es/web/jcyl/set/es/medio-rural-pesca/estaciones-gnss/1284807627392" dct:identifier="https://datosabiertos.jcyl.es/web/jcyl/set/es/medio-rural-pesca/estaciones-gnss/1284807627392" >
<dct:title xml:lang="es">Red de Estaciones GNSS de Castilla y León</dct:title>
<dct:description xml:lang="es">La Red GNSS es un servicio público libre y gratuito de posicionamiento de alta precisión con receptores GNSS (Sistemas de Navegación por Satélite) dentro del territorio de Castilla y León en datum ETRS89.

El sistema proporciona correcciones de código y fase para los sistemas de navegación GPS y GLONASS, tanto en tiempo real (corrección RTK DGPS, a través del estándar RTCM), como en postproceso a través de ficheros RINEX.</dct:description>
<dcat:theme rdf:resource="http://datos.gob.es/kos/sector-publico/sector/medio-rural-pesca"/>
<dcat:keyword xml:lang="es">Red GNSS</dcat:keyword>
<dcat:keyword xml:lang="es"> RINEX</dcat:keyword>
<dcat:keyword xml:lang="es"> RTCM</dcat:keyword>
<dcat:keyword xml:lang="es"> navegación por satélite</dcat:keyword>
<dcat:keyword xml:lang="es"> GPS</dcat:keyword>
<dcat:keyword xml:lang="es"> GLONASS</dcat:keyword>
<dct:language>es</dct:language>
<dct:publisher rdf:resource="http://datos.gob.es/recurso/sector-publico/org/Organismo/A07002862"/>
<dct:license rdf:resource="https://creativecommons.org/licenses/by/4.0/deed.es_ES"/>
