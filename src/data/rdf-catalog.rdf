<dcat:Dataset rdf:about="https://datosabiertos.jcyl.es/web/jcyl/set/es/medio-ambiente/topografico-10000-edificaciones-construcciones-poligonos/1284688179706" dct:identifier="https://datosabiertos.jcyl.es/web/jcyl/set/es/medio-ambiente/topografico-10000-edificaciones-construcciones-poligonos/1284688179706" >
<dct:title xml:lang="es">Mapa Topográfico de Castilla y León 1:10.000: Edificaciones y Construcciones - polígonos</dct:title>
<dct:description xml:lang="es">Capa de edificaciones y construcciones del Mapa Topográfico de Castilla y León 1:10.000 con geometría de polígonos.Mapa que aglutina todas las entidades geográficas de tipo superficial pertenecientes al tema de las construcciones/edificaciones (según modelo de datos de elaboración de la cartografía), que aparecen recogidas en las hojas de mapa de la serie Mapa Topográfico de Castilla y León 1:10.000.Representa y recopila todos los edificios y volúmenes constructivos de la edificación, estableciendo una organización y clasificación según criterio tipológico y funcional.</dct:description>
<dcat:theme rdf:resource="http://datos.gob.es/kos/sector-publico/sector/medio-ambiente"/>
<dcat:keyword xml:lang="es">Edificios</dcat:keyword>
<dct:language>es</dct:language>
<dct:publisher rdf:resource="http://datos.gob.es/recurso/sector-publico/org/Organismo/A07002862"/>
<dct:license rdf:resource="https://www.jcyl.es/licencia-IGCYL-NC"/>
<dcat:distribution>
<dcat:Distribution rdf:about="https://datosabiertos.jcyl.es/web/jcyl/risp/es/medio-ambiente/topografico-10000-edificaciones-construcciones-poligonos/1284688179706.shp">
