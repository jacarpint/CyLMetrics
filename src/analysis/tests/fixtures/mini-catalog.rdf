<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:dcat="http://www.w3.org/ns/dcat#"
         xmlns:dct="http://purl.org/dc/terms/">
  <dcat:Catalog rdf:about="http://example.org/catalog">
    <dcat:dataset>
      <dcat:Dataset rdf:about="http://example.org/ds/1">
        <dct:title>Dataset de prueba</dct:title>
        <dcat:distribution>
          <dcat:Distribution rdf:about="http://example.org/ds/1/csv">
            <dct:format><dct:IMT rdf:value="text/csv"/></dct:format>
            <dcat:accessURL rdf:resource="http://example.org/ds/1/data.csv"/>
          </dcat:Distribution>
        </dcat:distribution>
        <dcat:distribution>
          <dcat:Distribution rdf:about="http://example.org/ds/1/xlsx">
            <dct:format><dct:IMT rdf:value="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"/></dct:format>
            <dcat:accessURL rdf:resource="http://example.org/ds/1/data.xlsx"/>
          </dcat:Distribution>
        </dcat:distribution>
      </dcat:Dataset>
    </dcat:dataset>
  </dcat:Catalog>
</rdf:RDF>
